// TamgaSignFile: зовнішня обробка з єдиним сценарієм — підписати файл.
//
// Компонента лежить у макеті `TamgaAddIn` (ZIP-бандл MANIFEST.XML + Tamga.dll
// x86/x64), тому обробка самодостатня: нічого встановлювати окремо не треба.
//
// Підписаний файл кладеться поруч із вихідним: до повного імені додається
// розширення формату (`.p7s`, `.asics`, `.asice`). Якщо таке ім'я вже зайняте,
// додається лічильник — наявні підписи ніколи не перезаписуються.
//
// Двомовність: заголовки елементів беруться з метаданих форми (uk + ru),
// рядки коду — з НСтр через `Локализовать()`.

// Анотація обов'язкова: без неї змінна модуля керованої форми недоступна в
// процедурах з &НаКлиенте, і компілятор каже «Змінна не визначена».
&НаКлиенте
Перем Компонента;

////////////////////////////////////////////////////////////////////////////////
// Обробники форми

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ПустаяСтрока(ФорматПодписи) Тогда
		ФорматПодписи = "cms-detached";
	КонецЕсли;
	Результат = "";

	Элементы.Пароль.РежимПароля = Истина;
	Элементы.ФорматПодписи.РежимВыбораИзСписка = Истина;
	ЗаполнитьСписокФорматов();
КонецПроцедуры

&НаКлиенте
Процедура ФорматПодписиНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	// Список наповнюється тут, а не лише при відкритті: тоді перелік і його
	// підписи однаково коректні й після програмної зміни реквізиту.
	// СтандартнаяОбработка не чіпаємо — випадний список показує платформа.
	ЗаполнитьСписокФорматов();
КонецПроцедуры

&НаКлиенте
Процедура ФорматПодписиПриИзменении(Элемент)
	Если ФорматуНужнаСеть(ФорматПодписи) Тогда
		ВывестиСообщение(Локализовать(
			"uk = 'Цей формат потребує доступу до мережі: мітку часу видає зовнішній TSA.';
			|ru = 'Этот формат требует доступа к сети: метку времени выдаёт внешний TSA.'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФайлДокументаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;

	Заголовок = Локализовать(
		"uk = 'Виберіть файл для підпису';
		|ru = 'Выберите файл для подписи'");

	ФайлДокумента = ВыбратьФайл(Заголовок, ФильтрВсеФайлы(), ФайлДокумента);
КонецПроцедуры

&НаКлиенте
Процедура ФайлКлючаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;

	Заголовок = Локализовать(
		"uk = 'Виберіть файл ключа';
		|ru = 'Выберите файл ключа'");

	// Розширення тут — лише зручність діалогу. Тип контейнера компонента
	// визначає за вмістом файла, а не за розширенням: `.zs2` і `.dat` беруться
	// тим самим шляхом PKCS#12/PKCS#8, якщо всередині лежить саме такий
	// контейнер.
	Фильтр = Локализовать(
		"uk = 'Контейнери ключів';
		|ru = 'Контейнеры ключей'")
		+ "|*.dat;*.zs2;*.jks;*.pfx;*.p12;*.pem;*.der|"
		+ ФильтрВсеФайлы();

	ФайлКлюча = ВыбратьФайл(Заголовок, Фильтр, ФайлКлюча);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Основна дія

&НаКлиенте
Процедура Подписать(Команда)
	Результат = "";

	Если Не ФайлыВыбраныКорректно() Тогда
		Возврат;
	КонецЕсли;

	Если Не ПодключитьКомпоненту() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ВыполнитьПодписание();
	Исключение
		Результат = ОписаниеОшибки();
		ВывестиСообщение(Результат);
	КонецПопытки;

	// Ключ у пам'яті компоненти більше не потрібен — скидаємо і після успіху,
	// і після будь-якої помилки.
	Попытка
		Компонента.СброситьКлюч();
	Исключение
		// Скидання ключа не має ховати результат підписання.
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПодписание()
	Если Не ПодготовитьСессию() Тогда
		Возврат;
	КонецЕсли;

	// sourceType = "auto": тип контейнера визначається за вмістом. Пароль
	// сховища використовується і як пароль ключа.
	Если Не Компонента.ЗагрузитьКлюч(ФайлКлюча, Пароль, "", "", "auto") Тогда
		ЗафиксироватьОшибку(Локализовать(
			"uk = 'Завантаження ключа';
			|ru = 'Загрузка ключа'"));
		Возврат;
	КонецЕсли;

	ПутьРезультата = СформироватьПутьРезультата();

	// outputEncoding = "file": компонента сама записує підпис за вказаним
	// шляхом. Для asic-s/asic-e інші кодування недопустимі.
	РезультатПодписи = Компонента.ПодписатьФайл(
		ФайлДокумента, ПутьРезультата, ФорматПодписи, "file");

	Если РезультатПодписи = Ложь Тогда
		ЗафиксироватьОшибку(Локализовать(
			"uk = 'Підписання файла';
			|ru = 'Подписание файла'"));
		Возврат;
	КонецЕсли;

	Результат = Локализовать(
		"uk = 'Готово. Підпис збережено: ';
		|ru = 'Готово. Подпись сохранена: '") + ПутьРезультата;

	ВывестиСообщение(Результат);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Компонента

// Кожна розрядність — окремий макет із «голою» DLL, без ZIP-бандла.
// Потрібну обирає розрядність КЛІЄНТСЬКОГО процесу: саме він завантажує
// native-бібліотеку, тому x64-клієнт не візьме x86-DLL і навпаки.
&НаКлиенте
Функция ПодключитьКомпоненту()
	Если Компонента <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	ИмяМакета = ИмяМакетаКомпоненты();
	Если ПустаяСтрока(ИмяМакета) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Крок 1: підключення прямо з макета, без вивантаження на диск.
	Попытка
		Подключено = ПодключитьВнешнююКомпоненту(
			"ВнешняяОбработка.TamgaSignFile.Макет." + ИмяМакета,
			"Tamga",
			ТипВнешнейКомпоненты.Native);
	Исключение
		Подключено = Ложь;
	КонецПопытки;

	// Крок 2: макет вивантажується у тимчасовий файл, і DLL підключається з
	// диска — так само, як звичайна зовнішня компонента за повним шляхом.
	Если Не Подключено Тогда
		Подключено = ПодключитьКомпонентуИзВременногоФайла(ИмяМакета);
	КонецЕсли;

	Если Не Подключено Тогда
		ВывестиСообщение(Локализовать(
			"uk = 'Платформа не підключила компоненту Tamga. Макет: ';
			|ru = 'Платформа не подключила компоненту Tamga. Макет: '")
			+ ИмяМакета + ", " + ОписаниеПлатформы());
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Компонента = Новый("AddIn.Tamga.Tamga");
	Исключение
		ВывестиСообщение(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ИмяМакетаКомпоненты()
	Информация = Новый СистемнаяИнформация;

	Если Информация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
		Возврат "TamgaWindowsX64";
	ИначеЕсли Информация.ТипПлатформы = ТипПлатформы.Windows_x86 Тогда
		Возврат "TamgaWindowsX86";
	КонецЕсли;

	// Linux/macOS-збірки в макетах обробки не лежать: постачання компоненти
	// зараз Windows-only, і мовчазна спроба підключити .dll там не допоможе.
	ВывестиСообщение(Локализовать(
		"uk = 'Підтримується лише Windows x86 / x86_64. ';
		|ru = 'Поддерживается только Windows x86 / x86_64. '") + ОписаниеПлатформы());

	Возврат "";
КонецФункции

&НаКлиенте
Функция ПодключитьКомпонентуИзВременногоФайла(ИмяМакета)
	Попытка
		Каталог = РабочийКаталог();
		Если ПустаяСтрока(Каталог) Тогда
			Каталог = КаталогВременныхФайлов();
		Иначе
			Каталог = Каталог + ПолучитьРазделительПути();
		КонецЕсли;

		ПутьБиблиотеки = Каталог + ИмяФайлаБиблиотеки(ИмяМакета);

		Попытка
			ДанныеМакета = ДвоичныеДанныеМакета(ИмяМакета);
			ДанныеМакета.Записать(ПутьБиблиотеки);
		Исключение
			// DLL уже може бути завантажена цим процесом — тоді перезапис
			// неможливий, і підключати треба те, що вже лежить на диску.
			ФайлБиблиотеки = Новый Файл(ПутьБиблиотеки);
			Если Не ФайлБиблиотеки.Существует() Тогда
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;

		Возврат ПодключитьВнешнююКомпоненту(ПутьБиблиотеки, "Tamga", ТипВнешнейКомпоненты.Native);
	Исключение
		ВывестиСообщение(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ИмяФайлаБиблиотеки(ИмяМакета)
	Если ИмяМакета = "TamgaWindowsX64" Тогда
		Возврат "Tamga-windows-x64.dll";
	КонецЕсли;
	Возврат "Tamga-windows-x86.dll";
КонецФункции

&НаКлиенте
Функция ОписаниеПлатформы()
	Информация = Новый СистемнаяИнформация;
	Возврат Локализовать("uk = 'тип платформи: '; ru = 'тип платформы: '")
		+ Строка(Информация.ТипПлатформы);
КонецФункции

&НаСервере
Функция ДвоичныеДанныеМакета(ИмяМакета)
	Возврат РеквизитФормыВЗначение("Объект").ПолучитьМакет(ИмяМакета);
КонецФункции

&НаКлиенте
Функция ФорматуНужнаСеть(Формат)
	// Мітку часу видає зовнішній TSA, тож ці формати без мережі створюються
	// без неї. Контейнери ASiC теж штампуються: перевіряльники (зокрема Дія)
	// показують підпис без кваліфікованої позначки часу як неповний.
	Возврат Формат = "cades-t" Или Формат = "asic-s" Или Формат = "asic-e";
КонецФункции

&НаКлиенте
Функция ПодготовитьСессию()
	Офлайн = Не ФорматуНужнаСеть(ФорматПодписи);

	Если Не Компонента.Настроить(Офлайн, РабочийКаталог()) Тогда
		ЗафиксироватьОшибку(Локализовать(
			"uk = 'Налаштування компоненти';
			|ru = 'Настройка компоненты'"));
		Возврат Ложь;
	КонецЕсли;

	Если Не Офлайн Тогда
		// Порожній URL: адресу TSA компонента бере з довірчого списку ЦЗО або з
		// таблиці відомих КНЕДП за issuer'ом сертифіката. Для production задайте
		// адресу явно замість покладання на автовизначення.
		Компонента.НастроитьTSP("", "", 15000);
	КонецЕсли;

	Если Не Компонента.БиблиотекаИнициализирована Тогда
		Если Не Компонента.Инициализировать() Тогда
			ЗафиксироватьОшибку(Локализовать(
				"uk = 'Ініціалізація компоненти';
				|ru = 'Инициализация компоненты'"));
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;
КонецФункции

&НаКлиенте
Функция РабочийКаталог()
	Каталог = КаталогВременныхФайлов() + "Tamga1C";
	Попытка
		СоздатьКаталог(Каталог);
	Исключение
		// Порожній робочий каталог не блокує підписання: компонента візьме
		// власний тимчасовий каталог під час Инициализировать().
		Возврат "";
	КонецПопытки;
	Возврат Каталог;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Шлях результату

&НаКлиенте
Функция СформироватьПутьРезультата()
	Расширение = РасширениеРезультата();
	Кандидат = ФайлДокумента + Расширение;
	Счетчик = 1;

	Пока Истина Цикл
		ПроверяемыйФайл = Новый Файл(Кандидат);
		Если Не ПроверяемыйФайл.Существует() Тогда
			Прервать;
		КонецЕсли;
		Кандидат = ФайлДокумента + " (" + Формат(Счетчик, "ЧГ=0") + ")" + Расширение;
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Возврат Кандидат;
КонецФункции

&НаКлиенте
Функция РасширениеРезультата()
	Если ФорматПодписи = "asic-s" Тогда
		Возврат ".asics";
	ИначеЕсли ФорматПодписи = "asic-e" Тогда
		Возврат ".asice";
	КонецЕсли;
	Возврат ".p7s";
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Перевірки та повідомлення

&НаКлиенте
Функция ФайлыВыбраныКорректно()
	Если ПустаяСтрока(ФайлДокумента) Тогда
		ВывестиСообщение(Локализовать(
			"uk = 'Виберіть файл для підпису.';
			|ru = 'Выберите файл для подписи.'"));
		Возврат Ложь;
	КонецЕсли;

	Документ = Новый Файл(ФайлДокумента);
	Если Не Документ.Существует() Тогда
		ВывестиСообщение(Локализовать(
			"uk = 'Файл для підпису не знайдено.';
			|ru = 'Файл для подписи не найден.'"));
		Возврат Ложь;
	КонецЕсли;

	Если ПустаяСтрока(ФайлКлюча) Тогда
		ВывестиСообщение(Локализовать(
			"uk = 'Виберіть файл ключа КЕП.';
			|ru = 'Выберите файл ключа КЭП.'"));
		Возврат Ложь;
	КонецЕсли;

	Ключ = Новый Файл(ФайлКлюча);
	Если Не Ключ.Существует() Тогда
		ВывестиСообщение(Локализовать(
			"uk = 'Файл ключа не знайдено.';
			|ru = 'Файл ключа не найден.'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ЗафиксироватьОшибку(Шаг)
	Текст = Шаг + ": " + Компонента.ПолучитьОшибку();
	Результат = Текст;
	ВывестиСообщение(Текст);
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСообщение(Текст)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Список форматів і локалізація

&НаКлиенте
Процедура ЗаполнитьСписокФорматов()
	Список = Элементы.ФорматПодписи.СписокВыбора;
	Список.Очистить();

	// cms-attached тут навмисно немає: ПодписатьФайл відхиляє його в будь-якому
	// кодуванні. Для attached-підпису використовується ПодписатьДанные.
	Список.Добавить("cms-detached", Локализовать(
		"uk = 'CMS detached — окремий файл .p7s';
		|ru = 'CMS detached — отдельный файл .p7s'"));
	Список.Добавить("cades-bes", Локализовать(
		"uk = 'CAdES-BES — .p7s, без мітки часу';
		|ru = 'CAdES-BES — .p7s, без метки времени'"));
	Список.Добавить("cades-t", Локализовать(
		"uk = 'CAdES-T — .p7s з міткою часу (потрібна мережа)';
		|ru = 'CAdES-T — .p7s с меткой времени (нужна сеть)'"));
	Список.Добавить("asic-s", Локализовать(
		"uk = 'ASiC-S — контейнер .asics';
		|ru = 'ASiC-S — контейнер .asics'"));
	Список.Добавить("asic-e", Локализовать(
		"uk = 'ASiC-E — контейнер .asice';
		|ru = 'ASiC-E — контейнер .asice'"));
КонецПроцедуры

&НаКлиенте
Функция ВыбратьФайл(Заголовок, Фильтр, ТекущееЗначение)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = Заголовок;
	Диалог.Фильтр = Фильтр;
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Диалог.МножественныйВыбор = Ложь;
	Если Не ПустаяСтрока(ТекущееЗначение) Тогда
		Диалог.ПолноеИмяФайла = ТекущееЗначение;
	КонецЕсли;
	Если Диалог.Выбрать() Тогда
		Возврат Диалог.ПолноеИмяФайла;
	КонецЕсли;
	// Скасування діалогу не має стирати те, що вже було вибрано.
	Возврат ТекущееЗначение;
КонецФункции

&НаКлиенте
Функция ФильтрВсеФайлы()
	Возврат Локализовать(
		"uk = 'Усі файли';
		|ru = 'Все файлы'") + "|*.*";
КонецФункции

// НСтр повертає порожній рядок, якщо в шаблоні немає поточної мови сеансу.
// Тому мова сеансу — перший вибір, а uk/ru — явні запасні варіанти: обробка
// лишається читабельною і в конфігурації з третьою мовою інтерфейсу.
&НаКлиенте
Функция Локализовать(Шаблон)
	Текст = НСтр(Шаблон);
	Если ПустаяСтрока(Текст) Тогда
		Текст = НСтр(Шаблон, "uk");
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		Текст = НСтр(Шаблон, "ru");
	КонецЕсли;
	Возврат Текст;
КонецФункции
