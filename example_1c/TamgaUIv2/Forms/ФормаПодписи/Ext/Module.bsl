&НаКлиенте
Функция ВыбратьФайл(Заголовок, Фильтр, ТекущееЗначение, Сохранение)
	Если Сохранение Тогда
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Иначе
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	КонецЕсли;
	Диалог.Заголовок = Заголовок;
	Диалог.Фильтр = Фильтр;
	Если Не ПустаяСтрока(ТекущееЗначение) Тогда
		Диалог.ПолноеИмяФайла = ТекущееЗначение;
	КонецЕсли;
	Если Диалог.Выбрать() Тогда
		Возврат Диалог.ПолноеИмяФайла;
	КонецЕсли;
	Возврат ТекущееЗначение;
КонецФункции

&НаКлиенте
Функция ВыбратьКаталог(ТекущееЗначение)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Виберіть робочий каталог";
	Если Не ПустаяСтрока(ТекущееЗначение) Тогда
		Диалог.Каталог = ТекущееЗначение;
	КонецЕсли;
	Если Диалог.Выбрать() Тогда
		Возврат Диалог.Каталог;
	КонецЕсли;
	Возврат ТекущееЗначение;
КонецФункции

&НаКлиенте
Функция ВыбратьИзСписка(Заголовок, ТекущееЗначение, ЗначенияЧерезЗапятую)
	Список = Новый СписокЗначений;
	Для Каждого Значение Из СтрРазделить(ЗначенияЧерезЗапятую, ",") Цикл
		Список.Добавить(Значение, Значение);
	КонецЦикла;
	Выбранное = Список.ВыбратьЭлемент(Заголовок);
	Если Выбранное = Неопределено Тогда
		Возврат ТекущееЗначение;
	КонецЕсли;
	Возврат Выбранное.Значение;
КонецФункции
