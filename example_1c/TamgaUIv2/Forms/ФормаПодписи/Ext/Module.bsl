// TamgaUIv2: увесь код тестової обробки знаходиться в модулі форми.

Перем КомпонентаKalyna;
Перем ПоследняяПодписьДанных;
Перем ПоследнийAttachedCMS;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ИспользоватьАсинхронноеПодключение = Истина;
	РежимОфлайн = Ложь;
	РабочийКаталог = "";
	СостояниеКомпоненты = "Не підключено";
	ТипИсточникаКлюча = "auto";
	ФорматПодписиДанных = "cms-detached";
	КодированиеРезультатаДанных = "base64";
	КодированиеСодержимого = "none";
	ФорматПодписиФайла = "cades-bes";
	КодированиеФайла = "file";
	ТипASiC = "asic-e";
	TSP_URL = "https://acsk.privatbank.ua/services/tsp/";
	TSP_Policy = "";
	OCSP_URL = "";
	LDAP_URL = "";
	LDAP_BaseDn = "";
	CMP_URL = "";
	CMP_Profile = "";
	Журнал = "";
	ПоследняяОшибка = "";
	ПоследнийОтчет = "";
	ДобавитьВЖурнал("Форма TamgaUIv2 відкрита");
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьКомпоненту(Команда)
	Если ИспользоватьАсинхронноеПодключение Тогда
		ДобавитьВЖурнал("Почато асинхронне підключення компоненти з макета");
		Попытка
			НачатьАсинхронноеПодключениеКомпоненты(
				Новый ОписаниеОповещения("ПослеПодключенияКомпоненты", ЭтаФорма),
				"ВнешняяОбработка.TamgaUIv2.Макет.TamgaUI",
				"Kalyna"
			);
		Исключение
			ДобавитьВЖурнал("Асинхронне підключення недоступне: " + ОписаниеОшибки());
			ПодключитьКомпонентуСинхронно();
		КонецПопытки;
	Иначе
		ПодключитьКомпонентуСинхронно();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияКомпоненты(Результат, ДополнительныеПараметры) Экспорт
	Если Результат Тогда
		СоздатьОбъектКомпоненты();
		ДобавитьВЖурнал("Компонента підключена асинхронно");
	Иначе
		ДобавитьВЖурнал("Асинхронне підключення повернуло Ложь, запускаю fallback");
		ПодключитьКомпонентуСинхронно();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьКомпонентуСинхронно()
	Попытка
		// Прямий варіант підключення з макета для сумісності з вимогою:
		// РезультатПодключения = ПодключитьВнешнююКомпоненту("ВнешняяОбработка.Калина.Макет.Tamga", "Kalyna", ТипВнешнейКомпоненты.Native);
		РезультатПодключения = ПодключитьВнешнююКомпоненту(
			"ВнешняяОбработка.TamgaUIv2.Макет.TamgaUI",
			"Kalyna",
			ТипВнешнейКомпоненты.Native
		);

		Если Не РезультатПодключения Тогда
			ДобавитьВЖурнал("Підключення з макета не вдалося, записую макет у тимчасовий файл");
			ДвоичныеДанные = ПолучитьМакетКомпонентыНаСервере();
			ИмяФайла = ПолучитьИмяВременногоФайла("zip");
			ДвоичныеДанные.Записать(ИмяФайла);
			РезультатПодключения = ПодключитьВнешнююКомпоненту(ИмяФайла, "Kalyna", ТипВнешнейКомпоненты.Native);
		КонецЕсли;

		Если Не РезультатПодключения Тогда
			ВызватьИсключение "Платформа не підключила NativeAPI-компоненту";
		КонецЕсли;

		СоздатьОбъектКомпоненты();
		ДобавитьВЖурнал("Компонента підключена синхронно");
	Исключение
		СостояниеКомпоненты = "Помилка підключення";
		ПоследняяОшибка = ОписаниеОшибки();
		ДобавитьВЖурнал("Помилка підключення: " + ПоследняяОшибка);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОбъектКомпоненты()
	КомпонентаKalyna = Новый("AddIn.Kalyna.Tamga");
	СостояниеКомпоненты = "Підключено";
КонецПроцедуры

&НаСервере
Функция ПолучитьМакетКомпонентыНаСервере()
	Возврат ПолучитьМакет("TamgaUI");
КонецФункции

&НаКлиенте
Процедура ИнициализироватьКомпоненту(Команда)
	Если Не КомпонентаГотова() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если Не КомпонентаKalyna.Configure(РежимОфлайн, РабочийКаталог) Тогда
			ЗафиксироватьОшибку("Configure");
			Возврат;
		КонецЕсли;

		КомпонентаKalyna.ConfigureTsp(TSP_URL, TSP_Policy, 10000);
		КомпонентаKalyna.ConfigureOcsp(OCSP_URL, Истина, 10000);
		КомпонентаKalyna.ConfigureLdap(LDAP_URL, LDAP_BaseDn, 10000);
		КомпонентаKalyna.ConfigureCmp(CMP_URL, CMP_Profile, 10000);

		// Довірчий список ЦЗО. Порожній URL означає стандартний
		// https://czo.gov.ua/download/tl/TL-UA-EC.xml, TTL кешу — 24 години.
		// Політику підпису TL лишаємо типовою (prefer-available): підпис TL
		// перевіряється завжди, коли збірка має XMLDSIG-рушій.
		Если Не КомпонентаKalyna.ConfigureTrustList("", 30000, 24, "", "") Тогда
			ЗафиксироватьОшибку("ConfigureTrustList");
			Возврат;
		КонецЕсли;

		Если Не КомпонентаKalyna.Initialize() Тогда
			ЗафиксироватьОшибку("Initialize");
			Возврат;
		КонецЕсли;

		СостояниеКомпоненты = "Ініціалізовано";
		ДобавитьВЖурнал("Компоненту ініціалізовано через API V2");

		// SyncTrustList() потребує виконаного Initialize() і offline=false.
		// Без нього trust-store порожній, і перевірка підпису лишається
		// перевіркою криптографічної цілісності, а не довіри.
		СинхронизироватьДоверенныйСписок();
	Исключение
		ЗафиксироватьИсключение("Ініціалізація");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьКомпоненту(Команда)
	Если КомпонентаKalyna = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		КомпонентаKalyna.Finalize();
		СостояниеКомпоненты = "Завершено";
		ДобавитьВЖурнал("Роботу компоненти завершено");
	Исключение
		ЗафиксироватьИсключение("Finalize");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКлюч(Команда)
	Если Не КомпонентаГотова() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если Не КомпонентаKalyna.LoadKey(ФайлКлюча, Пароль, ПарольКлюча, АлиасКлюча, ТипИсточникаКлюча) Тогда
			ЗафиксироватьОшибку("LoadKey");
			Возврат;
		КонецЕсли;

		ДобавитьВЖурнал("Ключ завантажено: " + ТипИсточникаКлюча);
	Исключение
		ЗафиксироватьИсключение("LoadKey");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СброситьКлюч(Команда)
	Если Не КомпонентаГотова() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		КомпонентаKalyna.ResetKey();
		ДобавитьВЖурнал("Ключ скинуто");
	Исключение
		ЗафиксироватьИсключение("ResetKey");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура SignDataFromForm(Команда)
	Если Не КомпонентаГотова() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Данные = ПолучитьДвоичныеДанныеИзСтроки(ТекстДанных, КодировкаТекста.UTF8);
		Результат = КомпонентаKalyna.SignData(Данные, ФорматПодписиДанных, КодированиеРезультатаДанных);

		Если Результат = Ложь Тогда
			ЗафиксироватьОшибку("SignData");
			Возврат;
		КонецЕсли;

		Если КодированиеРезультатаДанных = "base64" Тогда
			ПодписьBase64 = Результат;
		Иначе
			ПоследняяПодписьДанных = Результат;
			Если ФорматПодписиДанных = "cms-attached" Тогда
				ПоследнийAttachedCMS = Результат;
			КонецЕсли;
			ПодписьBase64 = "<binary result збережено в пам'яті форми>";
		КонецЕсли;

		ДобавитьВЖурнал("SignData виконано: " + ФорматПодписиДанных + ", " + КодированиеРезультатаДанных);
	Исключение
		ЗафиксироватьИсключение("SignData");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура VerifyDataFromForm(Команда)
	Если Не КомпонентаГотова() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если ФорматПодписиДанных = "cms-attached" Тогда
			Данные = Неопределено;
			Подпись = ?(ПоследнийAttachedCMS = Неопределено, ПодписьBase64, ПоследнийAttachedCMS);
			КодированиеВхода = ?(ПоследнийAttachedCMS = Неопределено, "base64", "binary");
		Иначе
			Данные = ПолучитьДвоичныеДанныеИзСтроки(ТекстДанных, КодировкаТекста.UTF8);
			Если КодированиеРезультатаДанных = "base64" Тогда
				Подпись = ПодписьBase64;
				КодированиеВхода = "base64";
			Иначе
				Подпись = ПоследняяПодписьДанных;
				КодированиеВхода = "binary";
			КонецЕсли;
		КонецЕсли;

		Результат = КомпонентаKalyna.VerifyData(Данные, Подпись, ФорматПодписиДанных, КодированиеВхода, КодированиеСодержимого);
		Если Результат = Ложь Тогда
			ЗафиксироватьОшибку("VerifyData");
		Иначе
			Если КодированиеСодержимого = "text" Тогда
				ПодписьBase64 = Результат;
			КонецЕсли;
			ДобавитьВЖурнал("VerifyData успішно виконано");
		КонецЕсли;
		ОбновитьОтчет(Неопределено);
	Исключение
		ЗафиксироватьИсключение("VerifyData");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура SignFileFromForm(Команда)
	Если Не КомпонентаГотова() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Результат = КомпонентаKalyna.SignFile(ФайлДокумента, ФайлПодписи, ФорматПодписиФайла, КодированиеФайла);
		Если Результат = Ложь Тогда
			ЗафиксироватьОшибку("SignFile");
			Возврат;
		КонецЕсли;

		Если КодированиеФайла = "base64" Тогда
			ПодписьBase64 = Результат;
		ИначеЕсли КодированиеФайла = "binary" Тогда
			ПоследняяПодписьДанных = Результат;
			ПодписьBase64 = "<binary file signature збережено в пам'яті форми>";
		КонецЕсли;

		ДобавитьВЖурнал("SignFile виконано: " + ФорматПодписиФайла + ", " + КодированиеФайла);
	Исключение
		ЗафиксироватьИсключение("SignFile");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура VerifyFileFromForm(Команда)
	Если Не КомпонентаГотова() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если КодированиеФайла = "file" Тогда
			Подпись = ФайлПодписи;
			КодированиеВхода = "file";
		ИначеЕсли КодированиеФайла = "base64" Тогда
			Подпись = ПодписьBase64;
			КодированиеВхода = "base64";
		Иначе
			Подпись = ПоследняяПодписьДанных;
			КодированиеВхода = "binary";
		КонецЕсли;

		Результат = КомпонентаKalyna.VerifyFile(ФайлДокумента, Подпись, "cms-detached", КодированиеВхода);
		Если Результат Тогда
			ДобавитьВЖурнал("VerifyFile: підпис валідний");
		Иначе
			ЗафиксироватьОшибку("VerifyFile");
		КонецЕсли;
		ОбновитьОтчет(Неопределено);
	Исключение
		ЗафиксироватьИсключение("VerifyFile");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура SignASiCFromForm(Команда)
	Если Не КомпонентаГотова() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если Не КомпонентаKalyna.SignFile(ФайлASiCДокумента, ФайлASiCКонтейнера, ТипASiC, "file") Тогда
			ЗафиксироватьОшибку("SignFile ASiC");
			Возврат;
		КонецЕсли;
		ДобавитьВЖурнал("ASiC контейнер створено: " + ТипASiC);
	Исключение
		ЗафиксироватьИсключение("SignFile ASiC");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура VerifyASiCFromForm(Команда)
	Если Не КомпонентаГотова() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Результат = КомпонентаKalyna.VerifyFile(ФайлASiCКонтейнера, "", ТипASiC, "file");
		Если Результат Тогда
			ДобавитьВЖурнал("VerifyFile ASiC: контейнер валідний");
		Иначе
			ЗафиксироватьОшибку("VerifyFile ASiC");
		КонецЕсли;
		ОбновитьОтчет(Неопределено);
	Исключение
		ЗафиксироватьИсключение("VerifyFile ASiC");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьДоверенныйСписок()
	Если РежимОфлайн Тогда
		// В offline-режимі SyncTrustList() свідомо повертає Ложь і
		// OnlineServiceUnavailable, не звертаючись до мережі. Це не помилка
		// інтеграції, тому виклик просто пропускаємо.
		ДобавитьВЖурнал("Offline-режим: синхронізацію довірчого списку пропущено");
		Возврат;
	КонецЕсли;

	Попытка
		Если КомпонентаKalyna.SyncTrustList() Тогда
			ДобавитьВЖурнал("Довірчий список ЦЗО синхронізовано, trust-store заповнено");
		Иначе
			// Мережа, робочий каталог або запис кешу могли не спрацювати.
			// Компонента лишається робочою, але перевірка довіри буде неповною.
			ЗафиксироватьОшибку("SyncTrustList");
		КонецЕсли;
	Исключение
		ЗафиксироватьИсключение("SyncTrustList");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтчет(Команда)
	Если КомпонентаKalyna = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПоследняяОшибка = КомпонентаKalyna.GetError();

		// Два звіти мають різне призначення, і приклад показує обидва:
		// GetUserReport() — те, що показують користувачу;
		// GetReport() — технічна діагностика для розробника й логів.
		ПоследнийОтчет = "=== GetUserReport() — для показу користувачу ===" + Символы.ПС
			+ КомпонентаKalyna.GetUserReport() + Символы.ПС + Символы.ПС
			+ "=== GetReport() — технічний звіт для діагностики ===" + Символы.ПС
			+ КомпонентаKalyna.GetReport();
	Исключение
		ПоследняяОшибка = ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция КомпонентаГотова()
	Если КомпонентаKalyna = Неопределено Тогда
		ДобавитьВЖурнал("Компонента не підключена");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ЗафиксироватьОшибку(Операция)
	Попытка
		ПоследняяОшибка = КомпонентаKalyna.GetError();
	Исключение
		ПоследняяОшибка = "";
	КонецПопытки;
	ДобавитьВЖурнал(Операция + ": помилка " + ПоследняяОшибка);
КонецПроцедуры

&НаКлиенте
Процедура ЗафиксироватьИсключение(Операция)
	ПоследняяОшибка = ОписаниеОшибки();
	ДобавитьВЖурнал(Операция + ": виняток " + ПоследняяОшибка);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВЖурнал(Текст)
	НоваяСтрока = Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss") + "  " + Текст;
	Если ПустаяСтрока(Журнал) Тогда
		Журнал = НоваяСтрока;
	Иначе
		Журнал = Журнал + Символы.ПС + НоваяСтрока;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РабочийКаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	РабочийКаталог = ВыбратьКаталог(РабочийКаталог);
КонецПроцедуры

&НаКлиенте
Процедура ФайлКлючаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ФайлКлюча = ВыбратьФайл("Виберіть файл ключа", "Контейнери ключів|*.jks;*.p12;*.pfx;*.pem;*.der|Усі файли|*.*", ФайлКлюча, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ФайлДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ФайлДокумента = ВыбратьФайл("Виберіть документ", "Усі файли|*.*", ФайлДокумента, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ФайлПодписиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ФайлПодписи = ВыбратьФайл("Виберіть або задайте файл підпису", "Підписи|*.p7s;*.sig|Усі файли|*.*", ФайлПодписи, Истина);
КонецПроцедуры

