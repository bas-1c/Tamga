diff --git a/src/pthread/CMakeLists.txt b/src/pthread/CMakeLists.txt
index b01ed3a..c1156fe 100644
--- a/src/pthread/CMakeLists.txt
+++ b/src/pthread/CMakeLists.txt
@@ -1,8 +1,20 @@
 cmake_minimum_required(VERSION 3.5)
-project(pthread-impl)
+project(pthread-impl C)
 
 file(GLOB SOURCE c/*.c)
 
-add_library(pthread_impl STATIC ${SOURCE})
-target_link_libraries(pthread_impl pthread)
-target_include_directories(pthread_impl PUBLIC c/)
+if(MINGW)
+    add_library(pthread_impl STATIC ${SOURCE})
+    target_include_directories(pthread_impl PUBLIC c/)
+    find_package(Threads REQUIRED)
+    target_link_libraries(pthread_impl PUBLIC Threads::Threads)
+elseif(WIN32)
+    add_library(pthread_impl STATIC ${SOURCE})
+    target_include_directories(pthread_impl PUBLIC c/)
+    target_compile_definitions(pthread_impl PUBLIC WIN32_LEAN_AND_MEAN)
+else()
+    add_library(pthread_impl STATIC ${SOURCE})
+    target_include_directories(pthread_impl PUBLIC c/)
+    find_package(Threads REQUIRED)
+    target_link_libraries(pthread_impl PUBLIC Threads::Threads)
+endif()
