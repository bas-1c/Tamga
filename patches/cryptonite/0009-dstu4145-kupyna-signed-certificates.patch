@@ -946,7 +946,11 @@
     CHECK_PARAM(sign_parameters_str != NULL);
 
     if (pkix_check_oid_parent(&sign_parameters_str->signature_aid->algorithm,
-            oids_get_oid_numbers_by_id(OID_PKI_DSTU4145_WITH_GOST3411_ID))) {
+            oids_get_oid_numbers_by_id(OID_PKI_DSTU4145_WITH_GOST3411_ID))
+            || pkix_check_oid_parent(&sign_parameters_str->signature_aid->algorithm,
+                    oids_get_oid_numbers_by_id(OID_PKI_DSTU4145_WITH_DSTU7564_ID))) {
+        /* Обидві гілки — той самий ДСТУ 4145; різниться лише дайджест, а
