+static bool der_read_length(const uint8_t *der, size_t der_len, size_t *offset, size_t *value_len)
+{
+    size_t count;
+    size_t len = 0;
+    size_t i;
+
+    if (*offset >= der_len) {
+        return false;
+    }
+    count = der[(*offset)++];
+    if ((count & 0x80) == 0) {
+        *value_len = count;
+        return true;
+    }
+    count &= 0x7f;
+    if (count == 0 || count > sizeof(size_t) || count > der_len - *offset) {
+        return false;
+    }
+    for (i = 0; i < count; i++) {
