      "kernel32", "user32", "gdi32", "winspool", "shell32", "ole32", "oleaut32",
      "uuid", "comdlg32", "advapi32", "winhttp", "bcrypt", "bcryptprimitives",
      "crypt32", "ncrypt", "wldap32", "ws2_32", "mswsock", "secur32", "shlwapi",
