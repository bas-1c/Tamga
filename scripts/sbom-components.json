    "posix": [
      "pthread", "dl", "m", "rt", "c", "stdc++", "gcc", "gcc_s", "resolv",
      "anl", "atomic", "uuid"
    ]
  },

  "first_party_patterns": [
    "^tamga-",
    "^tamga$",
    "^Tamga$"
  ],

